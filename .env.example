# Copia este archivo a .env y rellena los valores. .env NUNCA se sube al repositorio.
# En GitHub Actions estos valores van en Settings > Secrets and variables > Actions.
# Si Betsson da las mismas cuentas para ambos mercados, repite los valores.

# betsson.com (inglés, EUR)
BETSSON_COM_FUNDED_USERNAME=
BETSSON_COM_FUNDED_PASSWORD=
BETSSON_COM_NO_BALANCE_USERNAME=
BETSSON_COM_NO_BALANCE_PASSWORD=

# betsson.es (español, EUR) — sustituye a betsson.pe
BETSSON_ES_FUNDED_USERNAME=
BETSSON_ES_FUNDED_PASSWORD=
BETSSON_ES_NO_BALANCE_USERNAME=
BETSSON_ES_NO_BALANCE_PASSWORD=
