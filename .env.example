# Copia este archivo a .env y rellena los valores. .env NUNCA se sube al repositorio.
# En GitHub Actions estos mismos nombres van en Settings > Secrets and variables > Actions.

# betsson.es — cuenta CON saldo (escenario 1: tirada completada)
BETSSON_ES_FUNDED_EMAIL=
BETSSON_ES_FUNDED_PASSWORD=

# betsson.es — cuenta SIN saldo (escenario 2: saldo insuficiente)
BETSSON_ES_NO_BALANCE_EMAIL=
BETSSON_ES_NO_BALANCE_PASSWORD=

# Anthropic (IA de visión): solo se usa para aprender o reparar el perfil de pantalla de un juego.
# Créala en https://console.anthropic.com/ → API Keys. En GitHub Actions, como Secret con el mismo nombre.
ANTHROPIC_API_KEY=

# Tope de gasto de IA por ejecución en USD (opcional; por defecto 0.05).
AI_BUDGET_USD=
